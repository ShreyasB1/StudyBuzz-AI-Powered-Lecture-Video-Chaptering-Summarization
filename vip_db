-- Enable pgvector in this database (run once per DB)
CREATE EXTENSION IF NOT EXISTS vector;

-- Table 2 from your spec: one row per lecture video
CREATE TABLE IF NOT EXISTS lecture_videos (
    id              BIGSERIAL PRIMARY KEY,
    video_hash      TEXT        NOT NULL UNIQUE,   -- prevents duplicate uploads across users
    done_processing BOOLEAN     NOT NULL DEFAULT FALSE,
    note            TEXT,                          -- your “String” field (free-form)
    folder_path     TEXT        NOT NULL,          -- path to lecture video folder on disk
    video_name      TEXT        NOT NULL,          -- human-readable video name
    video_date      TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

-- Table 1 from your spec: embeddings per chapter
CREATE TABLE IF NOT EXISTS chapter_embeddings (
    id              BIGSERIAL PRIMARY KEY,
    video_hash      TEXT        NOT NULL
                    REFERENCES lecture_videos(video_hash)
                    ON DELETE CASCADE,
    chapter_path    TEXT        NOT NULL,          
    model_name      TEXT        NOT NULL,          
    embedding       VECTOR(1536) NOT NULL,
    created_at      TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    UNIQUE (video_hash, chapter_path, model_name)  -- one embedding per chapter+model
);

-- Optional ANN index for fast similarity search
CREATE INDEX IF NOT EXISTS chapter_embeddings_embedding_idx
    ON chapter_embeddings
    USING ivfflat (embedding vector_cosine_ops)
    WITH (lists = 100);