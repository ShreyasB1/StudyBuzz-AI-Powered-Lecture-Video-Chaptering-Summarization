#!/usr/bin/env bash

echo "TIMING - Starting main script at: $(date)"
echo "Job directory: ${PWD}"

# ---------------------------------------------------------------------------
# Resolve app source directory from Open OnDemand's staged_root
# ---------------------------------------------------------------------------
STAGED_ROOT="<%= session.staged_root %>"
APP_NAME=$(echo "${STAGED_ROOT}" | sed -E 's|.*/batch_connect/dev/([^/]+)/.*|\1|')
APP_DIR="${HOME}/ondemand/dev/${APP_NAME}"

echo "App name: ${APP_NAME}"
echo "App source directory: ${APP_DIR}"

# ---------------------------------------------------------------------------
# Copy source code into the job directory
# ---------------------------------------------------------------------------
echo "Copying source code to job directory..."

for item in Dockerfile .dockerignore app.py timeStampGen.py vllm_to_vtt.py init_db.py requirements.txt requirements_backend.txt Makefile; do
  if [ -f "${APP_DIR}/${item}" ]; then
    cp "${APP_DIR}/${item}" "${PWD}/"
    echo "  Copied ${item}"
  else
    echo "WARNING: ${item} not found at ${APP_DIR}/${item}"
  fi
done

if [ -d "${APP_DIR}/static" ]; then
  cp -r "${APP_DIR}/static" "${PWD}/"
  echo "  Copied static/"
else
  echo "ERROR: static/ directory not found at ${APP_DIR}/static"
  exit 1
fi

# ---------------------------------------------------------------------------
# Configure Podman
# ---------------------------------------------------------------------------
export XDG_RUNTIME_DIR="/tmp/run-$(id -u)"
mkdir -p "$XDG_RUNTIME_DIR"
chmod 700 "$XDG_RUNTIME_DIR"

HOSTNAME=$(hostname)
echo "Hostname: ${HOSTNAME}"
echo "StudyBuzz port: ${STUDYBUZZ_PORT}"
echo "Number of GPUs: ${NUM_GPUS}"
echo "HuggingFace cache: ${HUGGINGFACE_CACHE_PATH}"

OUTPUT_DIR="${PWD}/output"
VIDEO_DIR="${OUTPUT_DIR}/video"
UPLOADS_DIR="${PWD}/uploads"
mkdir -p "${VIDEO_DIR}" "${UPLOADS_DIR}"

# ---------------------------------------------------------------------------
# GPU inventory — log all GPUs available on this node at startup
# ---------------------------------------------------------------------------
GPU_LOG="${PWD}/gpu_usage.log"
log_gpu() {
  local label="$1"
  echo "" >> "${GPU_LOG}"
  echo "=== ${label} — $(date) ===" >> "${GPU_LOG}"
  nvidia-smi --query-gpu=index,name,memory.used,memory.free,memory.total,utilization.gpu,temperature.gpu \
    --format=csv,noheader,nounits 2>&1 >> "${GPU_LOG}" || echo "nvidia-smi unavailable" >> "${GPU_LOG}"
  # Also echo a one-liner summary to output.log
  echo "GPU snapshot [${label}]: $(nvidia-smi --query-gpu=index,memory.used,memory.total,utilization.gpu --format=csv,noheader,nounits 2>/dev/null | tr '\n' '|' || echo 'n/a')"
}

echo "=== GPU Inventory at Job Start ===" | tee -a "${GPU_LOG}"
nvidia-smi -L 2>&1 | tee -a "${GPU_LOG}" || echo "nvidia-smi not found"
log_gpu "BASELINE (no containers yet)"

# ---------------------------------------------------------------------------
# Create Podman pod (shared network namespace for all containers)
# Only the Flask port is mapped externally; model servers use localhost.
# ---------------------------------------------------------------------------
echo "TIMING - Creating StudyBuzz pod at: $(date)"
POD_NAME="studybuzz-pod-${SLURM_JOB_ID}"

podman pod create \
  --name "${POD_NAME}" \
  -p "${STUDYBUZZ_PORT}:5000" \
  -p 8000:8000 \
  -p 8001:8001 \
  -p 8002:8002

echo "Pod created: ${POD_NAME}"

# ---------------------------------------------------------------------------
# Build the StudyBuzz app image
# ---------------------------------------------------------------------------
echo "TIMING - Building StudyBuzz app image at: $(date)"

podman build \
  -t "studybuzz-app-${SLURM_JOB_ID}" .

echo "TIMING - StudyBuzz image built at: $(date)"

# ---------------------------------------------------------------------------
# Start PostgreSQL pgvector database (port 5432, host network)
# ---------------------------------------------------------------------------
echo "TIMING - Starting PostgreSQL database at: $(date)"

mkdir -p "${PWD}/my_pgdata"
podman run -d \
  --name "pgvector_local-${SLURM_JOB_ID}" \
  --restart unless-stopped \
  --userns=keep-id \
  --net=host \
  -e POSTGRES_PASSWORD=mysecret \
  -e PGDATA=/var/lib/postgresql/data/pgdata \
  -e PGPORT=5432 \
  -v "${PWD}/my_pgdata:/var/lib/postgresql/data:Z" \
  docker.io/pgvector/pgvector:pg18-trixie

if podman ps --filter "name=pgvector_local-${SLURM_JOB_ID}" --format "{{.Names}}" | grep -q "pgvector_local"; then
  echo "PostgreSQL container is running."
else
  echo "ERROR: PostgreSQL container failed to start!"
  podman logs "pgvector_local-${SLURM_JOB_ID}" 2>&1 || true
fi

# Wait for PostgreSQL to accept connections before starting the app
echo "Waiting for PostgreSQL to become ready..."
PG_ELAPSED=0
PG_TIMEOUT=60
while [ ${PG_ELAPSED} -lt ${PG_TIMEOUT} ]; do
  if podman exec "pgvector_local-${SLURM_JOB_ID}" pg_isready -U postgres > /dev/null 2>&1; then
    echo "PostgreSQL is ready (after ${PG_ELAPSED}s)."
    break
  fi
  sleep 2
  PG_ELAPSED=$((PG_ELAPSED + 2))
done
if [ ${PG_ELAPSED} -ge ${PG_TIMEOUT} ]; then
  echo "WARNING: PostgreSQL did not become ready within ${PG_TIMEOUT}s."
  podman logs "pgvector_local-${SLURM_JOB_ID}" 2>&1 | tail -20 || true
fi

# ---------------------------------------------------------------------------
# Start the StudyBuzz Flask container (no GPU needed)
# ---------------------------------------------------------------------------
echo "TIMING - Starting StudyBuzz container at: $(date)"

podman run -d \
  --pod "${POD_NAME}" \
  --name "studybuzz-app-${SLURM_JOB_ID}" \
  --restart unless-stopped \
  -e VIP_DB_HOST=host.containers.internal \
  -v "${UPLOADS_DIR}:/app/uploads:Z" \
  -v "${OUTPUT_DIR}:/app/output:Z" \
  "studybuzz-app-${SLURM_JOB_ID}"

if podman ps --filter "name=studybuzz-app-${SLURM_JOB_ID}" --format "{{.Names}}" | grep -q "studybuzz-app"; then
  echo "StudyBuzz container is running."
else
  echo "ERROR: StudyBuzz container failed to start!"
  podman logs "studybuzz-app-${SLURM_JOB_ID}" 2>&1 || true
fi

echo "TIMING - StudyBuzz Flask app started at: $(date)"
echo "StudyBuzz web UI is now accessible on port ${STUDYBUZZ_PORT}"
echo "Access via OnDemand: https://ondemand-ice.pace.gatech.edu/node/${HOSTNAME}/${STUDYBUZZ_PORT}/"

# ---------------------------------------------------------------------------
# Start Mistral vLLM container (port 8000, all GPUs, ~90% VRAM)
# ---------------------------------------------------------------------------
echo "=== HuggingFace Path Diagnostics ==="
echo "  Configured path: '${HUGGINGFACE_CACHE_PATH}'"
if [ -n "${HUGGINGFACE_CACHE_PATH}" ]; then
  if [ -d "${HUGGINGFACE_CACHE_PATH}" ]; then
    echo "  Path EXISTS and is a directory."
    echo "  Contents:"
    ls -la "${HUGGINGFACE_CACHE_PATH}/" 2>&1 | head -20
    if [ -d "${HUGGINGFACE_CACHE_PATH}/hub" ]; then
      echo "  hub/ subdirectory contents:"
      ls "${HUGGINGFACE_CACHE_PATH}/hub/" 2>&1 | head -20
    else
      echo "  WARNING: No hub/ subdirectory found."
    fi
  elif [ -L "${HUGGINGFACE_CACHE_PATH}" ]; then
    echo "  Path is a SYMLINK but target does not exist."
    ls -la "${HUGGINGFACE_CACHE_PATH}" 2>&1
  else
    echo "  Path does NOT exist."
    PARENT_DIR=$(dirname "${HUGGINGFACE_CACHE_PATH}")
    echo "  Parent directory '${PARENT_DIR}':"
    ls -la "${PARENT_DIR}/" 2>&1 | head -20 || echo "  Parent also does not exist."
  fi
else
  echo "  Path is EMPTY (not set)."
fi
echo "=== End Path Diagnostics ==="

if [ -n "${HUGGINGFACE_CACHE_PATH}" ] && [ -d "${HUGGINGFACE_CACHE_PATH}" ]; then
  echo "TIMING - Starting Mistral vLLM server at: $(date)"

  TENSOR_PARALLEL=${NUM_GPUS:-8}

  # Only pass HF token env var if one was provided
  HF_TOKEN_ARGS=()
  if [ -n "${HF_TOKEN}" ]; then
    HF_TOKEN_ARGS=(--env "HUGGING_FACE_HUB_TOKEN=${HF_TOKEN}")
    echo "  HuggingFace token provided."
  else
    echo "  No HuggingFace token provided (models must already be cached)."
  fi

  podman run -d \
    --pod "${POD_NAME}" \
    --name "mistral-vllm-${SLURM_JOB_ID}" \
    --restart unless-stopped \
    --device nvidia.com/gpu=all \
    --security-opt=label=disable \
    --ipc=host \
    -v "${HUGGINGFACE_CACHE_PATH}:/root/.cache/huggingface" \
    -v "${VIDEO_DIR}:/root/video" \
    "${HF_TOKEN_ARGS[@]}" \
    --env "NCCL_DEBUG=INFO" \
    --env "OMP_NUM_THREADS=16" \
    docker.io/vllm/vllm-openai:qwen3_5-x86_64-cu129 \
    --model mistralai/Mistral-Large-3-675B-Instruct-2512 \
    --served-model-name mistral-large \
    --tensor-parallel-size "${TENSOR_PARALLEL}" \
    --gpu-memory-utilization 0.85 \
    --max-model-len 98304 \
    --limit-mm-per-prompt '{"image": 32}' \
    --max-num-batched-tokens 8192 \
    --enable-chunked-prefill \
    --max-num-seqs 2 \
    --load-format mistral \
    --tokenizer-mode mistral \
    --config-format mistral \
    --enable-auto-tool-choice \
    --tool-call-parser mistral \
    --allowed-local-media-path /root/video \
    --disable-custom-all-reduce \
    --host 0.0.0.0 \
    --port 8000

  if podman ps --filter "name=mistral-vllm-${SLURM_JOB_ID}" --format "{{.Names}}" | grep -q "mistral-vllm"; then
    echo "Mistral vLLM container is running. Model loading takes ~20 minutes."
    log_gpu "AFTER Mistral container started (model still loading)"
  else
    echo "ERROR: Mistral vLLM container failed to start!"
    podman logs "mistral-vllm-${SLURM_JOB_ID}" 2>&1 || true
  fi

  # Monitor Mistral readiness in the background.
  # Health checks run inside the Flask container (same pod network namespace)
  # because ports 8000/8001 are not published to the host.
  echo "Waiting for Mistral to be fully healthy before booting remaining models..."
  MISTRAL_ELAPSED=0
  MISTRAL_INTERVAL=30
  MISTRAL_TIMEOUT=2400
  while [ ${MISTRAL_ELAPSED} -lt ${MISTRAL_TIMEOUT} ]; do
    if podman exec "studybuzz-app-${SLURM_JOB_ID}" python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health', timeout=5)" > /dev/null 2>&1; then
      echo "TIMING - Mistral model fully loaded and ready at: $(date) (after ${MISTRAL_ELAPSED}s)"
      log_gpu "AFTER Mistral fully loaded (all 8 GPUs at ~85% VRAM)"
      break
    fi
    sleep ${MISTRAL_INTERVAL}
    MISTRAL_ELAPSED=$((MISTRAL_ELAPSED + MISTRAL_INTERVAL))
    echo "  Mistral still loading model... (${MISTRAL_ELAPSED}s elapsed)"
  done
  if [ ${MISTRAL_ELAPSED} -ge ${MISTRAL_TIMEOUT} ]; then
    echo "WARNING: Mistral health check timed out after ${MISTRAL_TIMEOUT}s. Check podman logs mistral-vllm-${SLURM_JOB_ID}"
    log_gpu "AFTER Mistral timeout (checking GPU state)"
  fi

  # -------------------------------------------------------------------------
  # Start Whisper vLLM container (port 8001, shares GPUs, ~9% VRAM)
  # -------------------------------------------------------------------------
  echo "TIMING - Starting Whisper vLLM server at: $(date)"

  podman run -d \
    --pod "${POD_NAME}" \
    --name "whisper-vllm-${SLURM_JOB_ID}" \
    --device nvidia.com/gpu=all \
    --security-opt=label=disable \
    --ipc=host \
    -v "${HUGGINGFACE_CACHE_PATH}:/root/.cache/huggingface" \
    "${HF_TOKEN_ARGS[@]}" \
    --env "VLLM_USE_DEEP_GEMM=0" \
    --entrypoint /bin/bash \
    docker.io/vllm/vllm-openai:qwen3_5-x86_64-cu129 \
    -c "pip install librosa soundfile && python3 -m vllm.entrypoints.openai.api_server \
      --model openai/whisper-large-v3 \
      --served-model-name whisper \
      --dtype bfloat16 \
      --max-model-len 448 \
      --tensor-parallel-size 1 \
      --swap-space 16 \
      --gpu-memory-utilization 0.075 \
      --trust-remote-code \
      --host 0.0.0.0 \
      --port 8001"

  if podman ps --filter "name=whisper-vllm-${SLURM_JOB_ID}" --format "{{.Names}}" | grep -q "whisper-vllm"; then
    echo "Whisper vLLM container is running. Model loading takes ~2 minutes."
  else
    echo "ERROR: Whisper vLLM container failed to start!"
    podman logs "whisper-vllm-${SLURM_JOB_ID}" 2>&1 || true
  fi

  # Monitor Whisper readiness in the background
  (
    WHISPER_ELAPSED=0
    WHISPER_INTERVAL=15
    WHISPER_TIMEOUT=600
    while [ ${WHISPER_ELAPSED} -lt ${WHISPER_TIMEOUT} ]; do
      if podman exec "studybuzz-app-${SLURM_JOB_ID}" python -c "import urllib.request; urllib.request.urlopen('http://localhost:8001/health', timeout=5)" > /dev/null 2>&1; then
        echo "TIMING - Whisper model fully loaded and ready at: $(date) (after ${WHISPER_ELAPSED}s)"
        log_gpu "AFTER Whisper fully loaded"
        break
      fi
      sleep ${WHISPER_INTERVAL}
      WHISPER_ELAPSED=$((WHISPER_ELAPSED + WHISPER_INTERVAL))
      echo "  Whisper still loading... (${WHISPER_ELAPSED}s elapsed)"
    done
    if [ ${WHISPER_ELAPSED} -ge ${WHISPER_TIMEOUT} ]; then
      echo "WARNING: Whisper health check timed out after ${WHISPER_TIMEOUT}s. Check podman logs whisper-vllm-${SLURM_JOB_ID}"
      log_gpu "AFTER Whisper timeout"
    fi
  ) &

  # -------------------------------------------------------------------------
  # Start Nemotron vLLM embedder container (port 8002, 4 GPUs shares)
  # -------------------------------------------------------------------------
  echo "TIMING - Starting Nemotron vLLM server at: $(date)"

  podman run -d \
    --pod "${POD_NAME}" \
    --name "nemotron-vllm-${SLURM_JOB_ID}" \
    --restart unless-stopped \
    --device nvidia.com/gpu=all \
    --security-opt=label=disable \
    --ipc=host \
    -v "${HUGGINGFACE_CACHE_PATH}:/root/.cache/huggingface" \
    "${HF_TOKEN_ARGS[@]}" \
    --env "CUDA_VISIBLE_DEVICES=1,2,3,4" \
    --env "VLLM_USE_V1=0" \
    docker.io/vllm/vllm-openai:qwen3_5-x86_64-cu129 \
    --model nvidia/llama-embed-nemotron-8b \
    --served-model-name nemotron \
    --tensor-parallel-size 4 \
    --gpu-memory-utilization 0.07 \
    --max-model-len 32768 \
    --trust-remote-code \
    --dtype bfloat16 \
    --enforce-eager \
    --disable-custom-all-reduce \
    --host 0.0.0.0 \
    --port 8002

  if podman ps --filter "name=nemotron-vllm-${SLURM_JOB_ID}" --format "{{.Names}}" | grep -q "nemotron-vllm"; then
    echo "Nemotron vLLM container is running. Model loading takes ~2 minutes."
  else
    echo "ERROR: Nemotron vLLM container failed to start!"
    podman logs "nemotron-vllm-${SLURM_JOB_ID}" 2>&1 || true
  fi

  # Monitor Nemotron readiness in the background
  (
    NEMO_ELAPSED=0
    NEMO_INTERVAL=15
    NEMO_TIMEOUT=600
    while [ ${NEMO_ELAPSED} -lt ${NEMO_TIMEOUT} ]; do
      if podman exec "studybuzz-app-${SLURM_JOB_ID}" python -c "import urllib.request; urllib.request.urlopen('http://localhost:8002/health', timeout=5)" > /dev/null 2>&1; then
        echo "TIMING - Nemotron model fully loaded and ready at: $(date) (after ${NEMO_ELAPSED}s)"
        log_gpu "AFTER Nemotron fully loaded (all models ready — steady state VRAM)"
        break
      fi
      sleep ${NEMO_INTERVAL}
      NEMO_ELAPSED=$((NEMO_ELAPSED + NEMO_INTERVAL))
      echo "  Nemotron still loading... (${NEMO_ELAPSED}s elapsed)"
    done
    if [ ${NEMO_ELAPSED} -ge ${NEMO_TIMEOUT} ]; then
      echo "WARNING: Nemotron health check timed out after ${NEMO_TIMEOUT}s. Check podman logs nemotron-vllm-${SLURM_JOB_ID}"
      log_gpu "AFTER Nemotron timeout"
    fi
  ) &

  # ---------------------------------------------------------------------------
  # Periodic GPU monitor — logs gpu_usage.log every 5 minutes indefinitely.
  # Lets you see memory and compute utilization while jobs are running.
  # ---------------------------------------------------------------------------
  (
    sleep 120  # wait for all models to settle before starting periodic logs
    while true; do
      log_gpu "PERIODIC"
      sleep 300
    done
  ) &

else
  echo "WARNING: HuggingFace cache path '${HUGGINGFACE_CACHE_PATH}' not found. Skipping model services."
  echo "  Video processing will not work until models are available."
fi

# Log job info
logger -p user.notice -t "ondemand" -- \
  "User: $USER; Host: $HOSTNAME; JobID: $SLURM_JOB_ID; StudyBuzz Port: ${STUDYBUZZ_PORT}"

# Keep the script alive so the SLURM job does not exit
tail -f /dev/null
