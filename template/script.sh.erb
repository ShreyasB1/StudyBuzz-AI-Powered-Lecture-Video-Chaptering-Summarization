#!/usr/bin/env bash

echo "TIMING - Starting main script at: $(date)"
echo "Job directory: ${PWD}"

# ---------------------------------------------------------------------------
# Resolve app source directory from Open OnDemand's staged_root
# ---------------------------------------------------------------------------
STAGED_ROOT="<%= session.staged_root %>"
APP_NAME=$(echo "${STAGED_ROOT}" | sed -E 's|.*/batch_connect/dev/([^/]+)/.*|\1|')
APP_DIR="${HOME}/ondemand/dev/${APP_NAME}"

echo "App name: ${APP_NAME}"
echo "App source directory: ${APP_DIR}"

# ---------------------------------------------------------------------------
# Copy source code into the job directory
# ---------------------------------------------------------------------------
echo "Copying source code to job directory..."

for item in Dockerfile .dockerignore app.py timeStampGen.py requirements.txt requirements_backend.txt Makefile; do
  if [ -f "${APP_DIR}/${item}" ]; then
    cp "${APP_DIR}/${item}" "${PWD}/"
    echo "  Copied ${item}"
  else
    echo "WARNING: ${item} not found at ${APP_DIR}/${item}"
  fi
done

if [ -d "${APP_DIR}/frontend" ]; then
  cp -r "${APP_DIR}/frontend" "${PWD}/"
  echo "  Copied frontend/"
else
  echo "ERROR: frontend/ directory not found at ${APP_DIR}/frontend"
  exit 1
fi

# ---------------------------------------------------------------------------
# Configure Podman
# ---------------------------------------------------------------------------
export XDG_RUNTIME_DIR="/tmp/run-$(id -u)"
mkdir -p "$XDG_RUNTIME_DIR"
chmod 700 "$XDG_RUNTIME_DIR"

HOSTNAME=$(hostname)
echo "Hostname: ${HOSTNAME}"
echo "StudyBuzz port: ${STUDYBUZZ_PORT}"
echo "vLLM port: ${VLLM_PORT}"
echo "Number of GPUs: ${NUM_GPUS}"
echo "HuggingFace cache: ${HUGGINGFACE_CACHE_PATH}"
echo "Whisper path: ${WHISPER_PATH}"

OUTPUT_DIR="${PWD}/output"
VIDEO_DIR="${OUTPUT_DIR}/video"
UPLOADS_DIR="${PWD}/uploads"
mkdir -p "${VIDEO_DIR}" "${UPLOADS_DIR}"

# ---------------------------------------------------------------------------
# Create Podman pod (shared network namespace for Flask + vLLM)
# ---------------------------------------------------------------------------
echo "TIMING - Creating StudyBuzz pod at: $(date)"
POD_NAME="studybuzz-pod-${SLURM_JOB_ID}"

podman pod create \
  --name "${POD_NAME}" \
  -p "${STUDYBUZZ_PORT}:5000" \
  -p "${VLLM_PORT}:8000"

echo "Pod created: ${POD_NAME}"

# ---------------------------------------------------------------------------
# Build the StudyBuzz app image FIRST (so Flask can start quickly)
# ---------------------------------------------------------------------------
echo "TIMING - Building StudyBuzz app image at: $(date)"

podman build \
  -t "studybuzz-app-${SLURM_JOB_ID}" .

echo "TIMING - StudyBuzz image built at: $(date)"

# ---------------------------------------------------------------------------
# Start the StudyBuzz Flask container
# Whisper mount is optional -- if the path doesn't exist, start without it.
# ---------------------------------------------------------------------------
echo "TIMING - Starting StudyBuzz container at: $(date)"

WHISPER_MOUNT_ARGS=()
if [ -n "${WHISPER_PATH}" ] && [ -d "${WHISPER_PATH}" ]; then
  echo "Whisper path found at ${WHISPER_PATH}, mounting into container."
  WHISPER_MOUNT_ARGS=(-v "${WHISPER_PATH}:/opt/whisper:ro" -e PATH="/opt/whisper:/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin")
else
  echo "WARNING: Whisper path '${WHISPER_PATH}' not found. Starting without Whisper."
  echo "  Transcription will not work until whisper-cli is available."
fi

podman run -d \
  --pod "${POD_NAME}" \
  --name "studybuzz-app-${SLURM_JOB_ID}" \
  -v "${UPLOADS_DIR}:/app/uploads:Z" \
  -v "${OUTPUT_DIR}:/app/output:Z" \
  "${WHISPER_MOUNT_ARGS[@]}" \
  "studybuzz-app-${SLURM_JOB_ID}"

if podman ps --filter "name=studybuzz-app-${SLURM_JOB_ID}" --format "{{.Names}}" | grep -q "studybuzz-app"; then
  echo "StudyBuzz container is running."
else
  echo "ERROR: StudyBuzz container failed to start!"
  podman logs "studybuzz-app-${SLURM_JOB_ID}" 2>&1 || true
fi

echo "TIMING - StudyBuzz Flask app started at: $(date)"
echo "StudyBuzz web UI is now accessible on port ${STUDYBUZZ_PORT}"
echo "Access via OnDemand: https://ondemand-ice.pace.gatech.edu/node/${HOSTNAME}/${STUDYBUZZ_PORT}/"

# ---------------------------------------------------------------------------
# Start vLLM container (model loading happens in the background)
# HuggingFace cache mount is optional -- skip vLLM if not available.
# ---------------------------------------------------------------------------
if [ -n "${HUGGINGFACE_CACHE_PATH}" ] && [ -d "${HUGGINGFACE_CACHE_PATH}" ]; then
  echo "TIMING - Starting vLLM server at: $(date)"

  TENSOR_PARALLEL=${NUM_GPUS:-8}

  podman run -d \
    --pod "${POD_NAME}" \
    --name "vllm-${SLURM_JOB_ID}" \
    --device nvidia.com/gpu=all \
    --ipc=host \
    -v "${HUGGINGFACE_CACHE_PATH}:/root/.cache/huggingface" \
    -v "${VIDEO_DIR}:/root/video" \
    docker.io/vllm/vllm-openai:latest \
    --model Qwen/Qwen3-VL-235B-A22B-Thinking-FP8 \
    --served-model-name Qwen3-VL \
    --enable-expert-parallel \
    --swap-space 16 \
    --max-num-seqs 512 \
    --gpu-memory-utilization 0.9 \
    --tensor-parallel-size "${TENSOR_PARALLEL}" \
    --allowed-local-media-path /root/video \
    --trust-remote-code \
    --host 0.0.0.0 \
    --port 8000

  if podman ps --filter "name=vllm-${SLURM_JOB_ID}" --format "{{.Names}}" | grep -q "vllm"; then
    echo "vLLM container is running. Model loading takes ~20 minutes in the background."
  else
    echo "ERROR: vLLM container failed to start!"
    podman logs "vllm-${SLURM_JOB_ID}" 2>&1 || true
  fi

  # Monitor vLLM readiness in the background (informational only)
  (
    VLLM_ELAPSED=0
    VLLM_INTERVAL=30
    while true; do
      if curl -s "http://localhost:8000/health" > /dev/null 2>&1; then
        echo "TIMING - vLLM model fully loaded and ready at: $(date)"
        break
      fi
      sleep ${VLLM_INTERVAL}
      VLLM_ELAPSED=$((VLLM_ELAPSED + VLLM_INTERVAL))
      echo "  vLLM still loading model... (${VLLM_ELAPSED}s elapsed)"
    done
  ) &
else
  echo "WARNING: HuggingFace cache path '${HUGGINGFACE_CACHE_PATH}' not found. Skipping vLLM."
  echo "  Video processing will not work until models are available."
fi

# Log job info
logger -p user.notice -t "ondemand" -- \
  "User: $USER; Host: $HOSTNAME; JobID: $SLURM_JOB_ID; StudyBuzz Port: ${STUDYBUZZ_PORT}; vLLM Port: ${VLLM_PORT}"

# Keep the script alive so the SLURM job does not exit
tail -f /dev/null
