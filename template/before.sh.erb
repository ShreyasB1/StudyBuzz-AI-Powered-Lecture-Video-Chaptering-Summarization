# This script is sourced into the main Bash script before script.sh is forked.
#
# Required exports:
#   - $host (already defined by Open OnDemand)
#   - $port (the port the web server listens on)

# Export the module function if it exists
[[ $(type -t module) == "function" ]] && export -f module

# Find available port for the StudyBuzz Flask app
port=$(find_port)

# Find available port for vLLM server
export VLLM_PORT=$(find_port ${port})

# Set Podman storage root to avoid conflicts between jobs
export PODMAN_STORAGE_ROOT="${HOME}/.local/share/containers/storage-${SLURM_JOB_ID}"
mkdir -p "${PODMAN_STORAGE_ROOT}"

# Export paths from the form
export HUGGINGFACE_CACHE_PATH="<%= context.huggingface_cache_path %>"
export WHISPER_PATH="<%= context.whisper_path %>"
export NUM_GPUS="<%= context.num_gpus %>"

# Export the main app port
export STUDYBUZZ_PORT=${port}
