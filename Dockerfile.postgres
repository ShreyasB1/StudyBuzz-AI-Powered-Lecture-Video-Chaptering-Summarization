# Custom PostgreSQL image with pre-initialized database and pgvector
# This avoids the chown issue on PACE by initializing the database at build time
# Use ankane/pgvector which has pgvector pre-installed
FROM docker.io/ankane/pgvector:v0.7.4

# Custom PostgreSQL image with pre-initialized database and pgvector
# This avoids the chown issue on PACE by initializing the database at build time
# Use ankane/pgvector which has pgvector pre-installed
FROM docker.io/ankane/pgvector:v0.7.4

# Switch to postgres user for initialization
USER postgres

# Pre-initialize the database as the postgres user (no chown needed!)
RUN initdb -D /var/lib/postgresql/data-template && \
    echo "host all all 0.0.0.0/0 trust" >> /var/lib/postgresql/data-template/pg_hba.conf && \
    echo "listen_addresses='*'" >> /var/lib/postgresql/data-template/postgresql.conf && \
    echo "fsync = off" >> /var/lib/postgresql/data-template/postgresql.conf && \
    echo "full_page_writes = off" >> /var/lib/postgresql/data-template/postgresql.conf && \
    echo "synchronous_commit = off" >> /var/lib/postgresql/data-template/postgresql.conf

# Start PostgreSQL temporarily to create the database and enable pgvector
RUN pg_ctl -D /var/lib/postgresql/data-template -o "-c listen_addresses=''" start && \
    sleep 3 && \
    psql -c "CREATE DATABASE vip_db;" && \
    psql -d vip_db -c "CREATE EXTENSION vector;" && \
    psql -d vip_db -c "CREATE TABLE lecture_videos ( \
        id BIGSERIAL PRIMARY KEY, \
        video_hash TEXT NOT NULL UNIQUE, \
        done_processing BOOLEAN NOT NULL DEFAULT FALSE, \
        note TEXT, \
        folder_path TEXT NOT NULL, \
        video_name TEXT NOT NULL, \
        video_date TIMESTAMPTZ NOT NULL DEFAULT NOW() \
    );" && \
    psql -d vip_db -c "CREATE TABLE chapter_embeddings ( \
        id BIGSERIAL PRIMARY KEY, \
        video_hash TEXT NOT NULL REFERENCES lecture_videos(video_hash) ON DELETE CASCADE, \
        chapter_path TEXT NOT NULL, \
        model_name TEXT NOT NULL, \
        embedding VECTOR(1536) NOT NULL, \
        created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(), \
        UNIQUE (video_hash, chapter_path, model_name) \
    );" && \
    psql -d vip_db -c "CREATE INDEX chapter_embeddings_embedding_idx \
        ON chapter_embeddings USING ivfflat (embedding vector_cosine_ops) WITH (lists = 100);" && \
    pg_ctl -D /var/lib/postgresql/data-template stop && \
    sleep 2

# Set environment to use the pre-initialized data
ENV PGDATA=/var/lib/postgresql/data-template

# Expose PostgreSQL port
EXPOSE 5432

# Start PostgreSQL (no initialization needed, just start!)
CMD ["postgres"]
