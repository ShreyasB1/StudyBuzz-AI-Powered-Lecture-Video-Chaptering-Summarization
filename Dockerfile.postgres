# Custom PostgreSQL image with pre-initialized database and pgvector
# Runs everything as root to avoid PACE's setresgid/chown restrictions.
# PostgreSQL is started with --allow-group-access to permit root execution.
FROM docker.io/ankane/pgvector:latest

ENV PGDATA=/var/lib/postgresql/data-template

# Run initdb and schema setup as root (no USER switch = no setresgid error)
RUN initdb --username=postgres --pgdata="${PGDATA}" --allow-group-access && \
    echo "host all all 0.0.0.0/0 trust" >> "${PGDATA}/pg_hba.conf" && \
    echo "listen_addresses='*'"          >> "${PGDATA}/postgresql.conf" && \
    echo "fsync = off"                   >> "${PGDATA}/postgresql.conf" && \
    echo "full_page_writes = off"        >> "${PGDATA}/postgresql.conf" && \
    echo "synchronous_commit = off"      >> "${PGDATA}/postgresql.conf" && \
    pg_ctl -D "${PGDATA}" -o "-c listen_addresses=''" start && \
    sleep 3 && \
    psql -U postgres -c "CREATE DATABASE vip_db;" && \
    psql -U postgres -d vip_db -c "CREATE EXTENSION vector;" && \
    psql -U postgres -d vip_db -c "CREATE TABLE lecture_videos (id BIGSERIAL PRIMARY KEY, video_hash TEXT NOT NULL UNIQUE, done_processing BOOLEAN NOT NULL DEFAULT FALSE, note TEXT, folder_path TEXT NOT NULL, video_name TEXT NOT NULL, video_date TIMESTAMPTZ NOT NULL DEFAULT NOW());" && \
    psql -U postgres -d vip_db -c "CREATE TABLE chapter_embeddings (id BIGSERIAL PRIMARY KEY, video_hash TEXT NOT NULL REFERENCES lecture_videos(video_hash) ON DELETE CASCADE, chapter_path TEXT NOT NULL, model_name TEXT NOT NULL, embedding VECTOR(1536) NOT NULL, created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(), UNIQUE (video_hash, chapter_path, model_name));" && \
    psql -U postgres -d vip_db -c "CREATE INDEX chapter_embeddings_embedding_idx ON chapter_embeddings USING ivfflat (embedding vector_cosine_ops) WITH (lists = 100);" && \
    pg_ctl -D "${PGDATA}" stop

EXPOSE 5432

# postgres refuses to start as root unless -allow-group-access or we pass --allow-group-access
# Since PACE maps us as root in the container, we must allow it explicitly
CMD ["postgres", "--allow-group-access"]
